<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#041833"
    android:orientation="vertical"
    android:padding="20dp">

    <Button
        android:id="@+id/btnVoltarTela3"
        style="@style/Widget.MaterialComponents.Button.TextButton"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="8dp"
        android:text="← Voltar"
        android:textColor="#ffffffff" />

    <TextView
        android:id="@+id/textView"
        android:layout_width="154dp"
        android:layout_height="60dp"
        android:text="ALURA"
        android:textColor="#F5F5F5F5"
        android:textSize="34sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/tvTituloCurso"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="24dp"
        android:text="Nome do Curso"
        android:textColor="#2196F3"
        android:textSize="22sp"
        android:textStyle="bold" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="16dp"
        android:text="Trilha de Aulas:"
        android:textColor="#ffffffff"
        android:textSize="18sp"
        android:textStyle="bold" />

    <!-- Lesson List -->
    <com.google.android.material.card.MaterialCardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="32dp"
        app:cardCornerRadius="12dp"
        app:cardElevation="2dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="#Ffffffff"
            android:backgroundTint="#ffffffff"
            android:orientation="vertical"
            android:padding="16dp">

            <CheckBox
                android:id="@+id/chkAula1"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:checked="true"
                android:padding="8dp"
                android:text="Aula 1: Introdução à Plataforma"
                android:textColor="#000000"
                android:textSize="16sp" />

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginVertical="8dp"
                android:background="#DDDDDD" />

            <CheckBox
                android:id="@+id/chkAula2"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:padding="8dp"
                android:text="Aula 2: Criando os primeiros componentes"
                android:textColor="#000000"
                android:textSize="16sp" />

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginVertical="8dp"
                android:background="#DDDDDD" />

            <CheckBox
                android:id="@+id/chkAula3"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:padding="8dp"
                android:text="Aula 3: Navegação e Intents"
                android:textColor="#000000"
                android:textSize="16sp" />

        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <Button
        android:id="@+id/btnConcluirAula"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:backgroundTint="#004D40"
        android:padding="12dp"
        android:text="Marcar Próxima Aula como Concluída" />

</LinearLayout>
